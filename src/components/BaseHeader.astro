---
const currentPage = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-brand">
      <img class="site-avatar" src="/images/avatar.png" alt="mousiji" width="40" height="40" />
      <span class="site-name">斯基的个人博客</span>
    </a>

    <button class="mobile-nav-toggle" aria-label="菜单" id="navToggle">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12h18M3 6h18M3 18h18"/>
      </svg>
    </button>

    <nav class="nav-links" id="navLinks">
      <a href="/" class={currentPage === '/' ? 'active' : ''}>首页</a>
      <a href="/blog" class={currentPage.startsWith('/blog') ? 'active' : ''}>博客</a>
      <a href="/archive" class={currentPage === '/archive' ? 'active' : ''}>归档</a>
      <a href="/tools" class={currentPage.startsWith('/tools') ? 'active' : ''}>工具</a>
      <a href="/tags" class={currentPage === '/tags' ? 'active' : ''}>标签</a>
      <a href="/friends" class={currentPage === '/friends' ? 'active' : ''}>友链</a>
      <a href="/about" class={currentPage === '/about' ? 'active' : ''}>关于</a>
      <a href="/search" class="nav-icon-btn" aria-label="搜索" title="搜索">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.6-3.6" />
        </svg>
      </a>
      <a href="/rss.xml" class="nav-icon-btn" aria-label="RSS 订阅" title="RSS 订阅" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <button class="theme-toggle" id="themeToggle" aria-label="切换主题">
        <span id="themeIcon">🌙</span>
      </button>
    </nav>
  </div>
</header>

<script>
  // Mobile nav toggle
  const navToggle = document.getElementById('navToggle');
  const navLinks = document.getElementById('navLinks');
  if (navToggle && navLinks) {
    navToggle.addEventListener('click', () => {
      navLinks.classList.toggle('open');
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node | null;
      if (!navToggle.contains(target) && !navLinks.contains(target)) {
        navLinks.classList.remove('open');
      }
    });
  }

  // Theme toggle
  const themeToggle = document.getElementById('themeToggle');
  const themeIcon = document.getElementById('themeIcon');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      if (themeIcon) {
        themeIcon.textContent = next === 'dark' ? '☀️' : '🌙';
      }
    });

    // Sync icon on load
    const html = document.documentElement;
    const current = html.getAttribute('data-theme');
    if (themeIcon) {
      themeIcon.textContent = current === 'dark' ? '☀️' : '🌙';
    }
  }
</script>
