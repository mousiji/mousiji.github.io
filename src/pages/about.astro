---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于" description="关于 mousiji 和这个博客">
  <div class="container">
    <div class="page-header">
      <h1>👤 关于我</h1>
    </div>

    <div class="about-content">
      <blockquote style="background: var(--blockquote-bg); border-left: 4px solid var(--blockquote-border); padding: 16px 20px; border-radius: 0 8px 8px 0; margin-bottom: 24px; color: var(--text-secondary); font-style: italic;">
        <p>欢迎来到我的小站呀，很高兴遇见你！🤝</p>
      </blockquote>

      <h2>🏠 关于本站</h2>
      <p>这是我的个人博客，使用 Astro 构建，托管在 GitHub Pages 上。我会在这里记录技术学习、生活感悟和各类有趣的内容。</p>

      <h2>👨‍💻 博主是谁</h2>
      <p>一个热爱技术和分享的开发者，喜欢折腾各种有趣的东西。目前专注于前端开发和跨境电子商务领域。</p>

      <h2>⛹ 兴趣爱好</h2>
      <p>编程、阅读、写作、旅行、摄影。喜欢探索新事物，也乐于沉淀和分享。</p>

      <h2>📬 联系我呀</h2>
      <p>如果你有任何问题或想法，欢迎在博客评论区留言交流，也可以点下面的图标找到我：</p>

      <div class="contact-icons">
        <a class="contact-icon" href="https://github.com/mousiji" target="_blank" rel="noopener" aria-label="GitHub 主页" title="GitHub：github.com/mousiji">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
        </a>
        <a class="contact-icon" href="mailto:mo.sji@outlook.com" aria-label="给我发邮件" title="邮箱：mo.sji@outlook.com">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M20,4L4,4c-1.1,0 -1.99,0.9 -1.99,2L2,18c0,1.1 0.9,2 2,2l16,0c1.1,0 2,-0.9 2,-2L22,6c0,-1.1 -0.9,-2 -2,-2zM20,8l-8,5 -8,-5L4,6l8,5 8,-5L20,8z"/>
