---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <div class="container" style="text-align: center; padding: 80px 24px;">
    <div style="font-size: 80px; font-weight: 800; color: var(--text-muted); line-height: 1; margin-bottom: 16px;">404</div>
    <p style="font-size: 18px; color: var(--text-secondary); margin-bottom: 32px;">页面未找到</p>
    <a href="/" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: var(--accent); color: #fff; border-radius: 8px; font-weight: 500;">
      ← 返回首页
    </a>
  </div>
</BaseLayout>