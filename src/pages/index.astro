---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const recentPosts = posts.slice(0, 6);
---

<BaseLayout title="斯基的个人博客" description="很高兴见到你=w= — 记录生活、分享思考的博客">
  <div class="container">
    <section class="hero">
      <img class="hero-avatar" src="/images/avatar.png" alt="mousiji" width="100" height="100" />
      <h1>斯基</h1>
      <p>很高兴见到你=w=</p>
    </section>

    <section>
      <h2 style="font-size: 20px; font-weight: 600; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
        <span>📝</span> 最新文章
      </h2>

      {recentPosts.length > 0 ? (
        <div class="blog-grid">
          {recentPosts.map((post) => (
            <article class="blog-card">
              <a href={`/blog/${post.slug}/`}>
                {post.data.heroImage ? (
                  <img class="blog-card-image" src={post.data.heroImage} alt={post.data.title} loading="lazy" />
                ) : (
                  <div class="blog-card-image-placeholder">📝</div>
                )}
              </a>
              <div class="blog-card-body">
                {post.data.tags.length > 0 && (
                  <div class="blog-card-tags">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <span class="blog-card-tag">{tag}</span>
                    ))}
                  </div>
                )}
                <h3 class="blog-card-title">
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                  {import.meta.env.DEV && post.data.draft && <span class="draft-badge">草稿</span>}
                </h3>
                <p class="blog-card-excerpt">{post.data.description || ''}</p>
                <div class="blog-card-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>还没有文章，敬请期待 🚀</p>
        </div>
      )}

      {posts.length > 6 && (
        <div style="text-align: center; margin-bottom: 48px;">
          <a href="/blog" style="display: inline-block; padding: 10px 24px; border: 1px solid var(--accent); border-radius: 8px; font-weight: 500; color: var(--accent);">
            查看所有文章 →
          </a>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
