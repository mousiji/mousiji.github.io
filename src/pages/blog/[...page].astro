---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  return paginate(posts, { pageSize: 6 });
}

const { page } = Astro.props;
---

<BaseLayout title="博客" description="mousiji 的所有博客文章">
  <div class="container">
    <div class="page-header">
      <h1>📝 所有文章</h1>
      <p>
        共 {page.total} 篇{page.lastPage > 1 ? ` · 第 ${page.currentPage} / ${page.lastPage} 页` : ''}
      </p>
    </div>

    {page.data.length > 0 ? (
      <div class="blog-grid">
        {page.data.map((post) => (
          <article class="blog-card">
            <a href={`/blog/${post.slug}/`}>
              {post.data.heroImage ? (
                <img class="blog-card-image" src={post.data.heroImage} alt={post.data.title} loading="lazy" />
              ) : (
                <div class="blog-card-image-placeholder">📝</div>
              )}
            </a>
            <div class="blog-card-body">
              {post.data.tags.length > 0 && (
                <div class="blog-card-tags">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="blog-card-tag">{tag}</span>
                  ))}
                </div>
              )}
              <h3 class="blog-card-title">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                {import.meta.env.DEV && post.data.draft && <span class="draft-badge">草稿</span>}
              </h3>
              <p class="blog-card-excerpt">{post.data.description || ''}</p>
              <div class="blog-card-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>还没有文章，敬请期待 🚀</p>
      </div>
    )}

    {page.lastPage > 1 && (
      <nav class="pagination" aria-label="分页导航">
        {page.url.prev ? (
          <a class="page-link" href={page.url.prev}>← 上一页</a>
        ) : (
          <span class="page-link page-link-disabled">← 上一页</span>
        )}
        <span class="page-info">第 {page.currentPage} / {page.lastPage} 页</span>
        {page.url.next ? (
          <a class="page-link" href={page.url.next}>下一页 →</a>
        ) : (
          <span class="page-link page-link-disabled">下一页 →</span>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
